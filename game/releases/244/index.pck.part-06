varying vec2 local_pos;
uniform float glyph_height=60.0;
uniform float sweep=-1.0;
uniform float text_width=300.0;
uniform bool ivory=false;
void vertex(){local_pos=VERTEX;}
void fragment(){
 vec4 glyph=texture(TEXTURE,UV)*COLOR;
 float y=clamp(local_pos.y/glyph_height,0.0,1.0);
 vec3 top=ivory?vec3(1.0,.99,.94):vec3(1.0,.96,.79);
 vec3 middle=ivory?vec3(.90,.91,.87):vec3(.91,.72,.35);
 vec3 bottom=ivory?vec3(.76,.81,.84):vec3(.67,.43,.15);
 vec3 metal=mix(top,middle,smoothstep(.20,.57,y));
 metal=mix(metal,bottom,smoothstep(.58,1.0,y));
 metal+=vec3(.12)*exp(-pow((y-.52)*55.0,2.0));
 float x=local_pos.x/max(text_width,1.0)-y*.12;
 float shine=exp(-pow((x-sweep)*19.0,2.0))*.40;
 COLOR=vec4(glyph.rgb*(metal+shine),glyph.a);
}
