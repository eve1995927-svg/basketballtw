·ÁCÁ—uýÝ_:Ï^OÑpÆÓ_˜Í9ú<@=-îñŸøy¼Ãš‘â»^ãƒŸÐqœj2×íAŠ×ó“‹\?ÕW´ó\¦úY3üßªžaü'XPÊ‡Ï2~Ü2WýBwFÝÂfÛƒÎòèjoC¬ÿüyðƒZì•7‹›þnGüùp9 £¡øß•þÇÏ÷3vcÝMÝë=jž÷lÀðéð^–Œ}q0\qÝßúHËwú`ã«ê­k_ØŽ‚=Þø
÷7RÈËð-´öýnÿüY>ëòÕ»\ÿ?DÜáïRÔ…Ü‹r—ñ3CzNˆklmé:÷çñŸù€n+¿^␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform float face_top = 16.0;
uniform float face_height = 46.0;
varying vec2 letter_position;

void vertex() {
	letter_position = VERTEX;
}

void fragment() {
	vec4 ink = COLOR;
	// Keep the separate dark outline/shadow passes dark, not gold.
	float face = smoothstep(0.5, 0.8, max(ink.r, max(ink.g, ink.b)));
	float y = clamp((letter_position.y - face_top) / face_height, 0.0, 1.0);
	// Broad champagne face: no dark stripe cutting through small glyphs.
	vec3 gold = mix(vec3(1.0, 0.98, 0.86), vec3(0.96, 0.77, 0.40), smoothstep(0.12, 0.85, y));
	gold = mix(gold, vec3(1.0, 0.88, 0.58), smoothstep(0.85, 1.0, y));
	float shine = exp(-pow((letter_position.x * 0.12 + letter_position.y - face_top - 16.0) / 5.0, 2.0));
	gold = mix(gold, vec3(1.0, 0.995, 0.94), shine * 0.45);
	COLOR = vec4(mix(ink.rgb, gold, face), ink.a);
}
