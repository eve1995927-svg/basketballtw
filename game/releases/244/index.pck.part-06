pãpµìçÛN@Üªäªg§ÝI~ ñ?’ûx9?éïäƒ'äo²ßnöé¹Ã8OÌùÎy—ùÀ„Á·¹Æï?™à„Ç{N}ò7c_d[5Á(fa¦ÛÈôÛ{á×;ç=røm{{¿Dì–ÚÌk}	*G¾â‚GC}™É“}çÍh‡À&C)!ƒ‡>#œï·ø7_á¹eÈ·ÐLVÝétd/d,àÈq°_õoæ¬Ü<ç#ò"óöyŠŸMûNgøûn¶óÑ=Y¼ƒ;‹˜³Rtpë§9WëtWÄm'Ly6*“QÿÚÙu6Ñ¹qäQï|;×p„uçÆÖ™C×÷ÿn|a9 ËIB?}ãv=<÷é	$ÆnŸ÷ùÉ©ûF"¯ân†½û@âš®«ú½`t¯{cöd^yÊW®¥ƒzÞ7¶YO^UgrŠ¿¨C“ú*c¹~ØõP_›!üûÌaº^+mý¿€ž¡¾O¸3‰|à†÷Ý"¦é½ßt™À©pðû'8‡iú¿ßCÏªxDâÊifö~ÈðQÆ<9Ë~†¿ëšÄÞSéáˆîû˜=Ñãõ‰ÿåÉŽºg2èÙ”G´šóÂ'£7ùóÉMÖ‰©_‰ÙËØÃq½)Kÿö·­õÆÈ&î›¿©~¯P÷NHãÛ¡÷]öˆñ³ôßAœ§…ƒ8Ÿ;Rc<í´:HØ¬=0ÐûzO«Ìny£^xÇ7žßÄ/@¿›ñÉý®€ñ^¤¿¢å¼tþÜôßOç³	{½½º×sé5i™Ê_`MCfXxGp>ýMon~PO¿•®ÝêÄ‹å;ØØ*&én!Øºá—ó¶¶¿~û¡×#°&å@˜Ð␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
varying vec4 item_tint;
void vertex(){item_tint=COLOR;}
uniform sampler2D portrait : filter_linear_mipmap, repeat_disable;
uniform sampler2D frame_art : filter_linear_mipmap, repeat_disable;
uniform sampler2D team_logo : filter_linear_mipmap, repeat_disable;
uniform sampler2D panel_art : filter_linear_mipmap, repeat_disable;
uniform sampler2D lettering : filter_linear, repeat_disable;
uniform sampler2D ratings : filter_linear, repeat_disable;
uniform sampler2D star_art : filter_linear_mipmap, repeat_disable;
uniform bool has_logo = false;
uniform vec4 logo_uv_rect = vec4(0.0,0.0,1.0,1.0);
uniform bool portrait_canvas = false;
uniform bool has_chest_repair = false;
uniform sampler2D chest_repair : filter_linear_mipmap, repeat_disable;
uniform vec4 chest_rect = vec4(0.0);
uniform vec4 logo_rect = vec4(60.0,65.0,260.0,270.0);
uniform int name_index = -1;
uniform int team_index = -1;
uniform int position_index = -1;
uniform int rating = 49;
uniform int stars = 0;
vec4 over(vec4 bottom,vec4 top) {
 float a=top.a+bottom.a*(1.0-top.a);
 return vec4((top.rgb*top.a+bottom.rgb*bottom.a*(1.0-top.a))/max(a,0.00001),a);
}
bool inside(vec2 uv){return all(greaterThanEqual(uv,vec2(0.0)))&&all(lessThanEqual(uv,vec2(1.0)));}
vec4 word(int index,vec2 p,vec4 rect){
 vec2 uv=(p-rect.xy)/rect.zw;
 if(index<0 || !inside(uv))return vec4(0.0);
 vec2 cell=vec2(float(index%8)*384.0,float(index/8)*90.0);
 return texture(lettering,(cell+uv*vec2(384.0,90.0))/vec2(textureSize(lettering,0)));
}
// Keep the approved glyphs; add restrained metallic fill and a dark keyline.
vec4 art_word(int index,vec2 p,vec4 rect){
 vec4 ink=word(index,p,rect);
 float rim=max(max(word(index,p+vec2(4.0,0.0),rect).a,word(index,p-vec2(4.0,0.0),rect).a),max(word(index,p+vec2(0.0,4.0),rect).a,word(index,p-vec2(0.0,4.0),rect).a));
 float lit=smoothstep(0.28,0.7,dot(ink.rgb,vec3(0.299,0.587,0.114)));
 float t=clamp((p.y-rect.y)/rect.w,0.0,1.0);
 vec3 metal=mix(vec3(1.0,0.97,0.85),vec3(0.79,0.61,0.30),t);
 ink.rgb=mix(ink.rgb,metal,lit);
 return over(vec4(0.015,0.025,0.04,rim*0.94),ink);
}
void fragment(){
 vec2 p=UV*vec2(1024.0,1536.0);
 vec4 c=texture(TEXTURE,UV);
 // Dim only the stadium before compositing the player, frame and lettering.
 c.rgb*=0.78;
 vec2 puv=portrait_canvas?UV:(p-vec2(25.0,90.0))/vec2(974.0,1461.0);
 if(inside(puv)){
  vec4 person=texture(portrait,puv);
  if(has_chest_repair){
   vec2 local=puv*vec2(1024.0,1536.0)-chest_rect.xy;
   vec2 edge=min(local,chest_rect.zw-local);
   float mask=smoothstep(0.0,9.0,min(edge.x,edge.y));
   person.rgb=mix(person.rgb,texture(chest_repair,puv).rgb,mask);
  }
  person.a*=1.0-smoothstep(970.0,1170.0,p.y);
  c=over(c,person);
 }
 c=over(c,texture(panel_art,UV));
 if(has_logo){vec2 luv=(p-logo_rect.xy)/logo_rect.zw;if(inside(luv))c=over(c,texture(team_logo,logo_uv_rect.xy+luv*logo_uv_rect.zw));}
 c=over(c,texture(frame_art,UV));
 for(int i=0;i<5;i++){
  if(i<stars){
   float center=512.0+(float(i)-float(stars-1)*0.5)*63.0;
   vec2 suv=(p-vec2(center-512.0,0.0))/vec2(1024.0,1536.0);
   if(inside(suv))c=over(c,texture(star_art,suv));
  }
 }
 c=over(c,art_word(team_index,p,vec4(16.0,1053.0,1024.0,218.0)));
 c=over(c,art_word(name_index,p,vec4(24.0,1239.0,1024.0,214.0)));
 c=over(c,word(position_index,p,vec4(337.0,249.0,1024.0,240.0)));
 vec2 ruv=(p-vec2(709.0,92.0))/vec2(280.0,192.0);
 if(rating>=0 && rating<200 && inside(ruv)){
  vec2 cell=vec2(float(rating%10)*140.0,float(rating/10)*96.0);
  c=over(c,texture(ratings,(cell+ruv*vec2(140.0,96.0))/vec2(textureSize(ratings,0))));
 }
 vec2 q=abs(p-vec2(512.0,768.0))-vec2(428.0,684.0);
 float edge=length(max(q,vec2(0.0)))+min(max(q.x,q.y),0.0)-84.0;
 c.a*=1.0-smoothstep(-0.8,0.8,edge);
 if(stars==5)c.rgb+=vec3(1.0,0.8,0.38)*exp(-abs(edge+5.0)/5.0)*0.20;
 COLOR=c*item_tint;
}
